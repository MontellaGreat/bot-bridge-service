@@ -0,0 +1,91 @@
+import { BRIDGE_CONTROL_BASE_URL, BRIDGE_CONTROL_TOKEN } from "../config";
+
+const BRIDGE_CACHE_TTL_MS = 5_000;
+
+type TimedCache<T> = {
+  value: T;
+  expiresAt: number;
+};
+
+export interface BridgeAdapterStatus {
+  configured: boolean;
+  baseUrl?: string;
+  tokenConfigured: boolean;
+}
+
+export interface BridgeFetchEnvelope<T> {
+  status: BridgeAdapterStatus;
+  data?: T;
+  error?: string;
+  fetchedAt: string;
+}
+
+const cache = new Map<string, TimedCache<unknown>>();
+const inflight = new Map<string, Promise<unknown>>();
+
+export function bridgeAdapterStatus(): BridgeAdapterStatus {
+  return {
+    configured: BRIDGE_CONTROL_BASE_URL !== "",
+    baseUrl: BRIDGE_CONTROL_BASE_URL || undefined,
+    tokenConfigured: BRIDGE_CONTROL_TOKEN !== "",
+  };
+}
+
+export async function fetchBridgeEndpoint<T>(path: string): Promise<BridgeFetchEnvelope<T>> {
+  const status = bridgeAdapterStatus();
+  const fetchedAt = new Date().toISOString();
+  if (!status.configured || !status.baseUrl) {
+    return {
+      status,
+      error: "Bridge control base URL is not configured.",
+      fetchedAt,
+    };
+  }
+
+  const key = path;
+  const now = Date.now();
+  const cached = cache.get(key);
+  if (cached && cached.expiresAt > now) {
+    return {
+      status,
+      data: cached.value as T,
+      fetchedAt,
+    };
+  }
+
+  const running = inflight.get(key);
+  if (running) {
+    try {
+      const value = (await running) as T;
+      return { status, data: value, fetchedAt };
+    } catch (error) {
+      return { status, error: error instanceof Error ? error.message : String(error), fetchedAt };
+    }
+  }
+
+  const requestPromise = (async () => {
+    const baseUrl = status.baseUrl ?? "";
+    const url = new URL(path, baseUrl.endsWith("/") ? baseUrl : `${baseUrl}/`);
+    const headers: Record<string, string> = {};
+    if (BRIDGE_CONTROL_TOKEN !== "") {
+      headers.Authorization = `Bearer ${BRIDGE_CONTROL_TOKEN}`;
+    }
+    const res = await fetch(url, { headers });
+    const text = await res.text();
+    if (!res.ok) {
+      throw new Error(`Bridge ${res.status}: ${text}`);
+    }
+    return text ? (JSON.parse(text) as T) : ({} as T);
+  })();
+
+  inflight.set(key, requestPromise);
+  try {
+    const value = await requestPromise;
+    cache.set(key, { value, expiresAt: now + BRIDGE_CACHE_TTL_MS });
+    return { status, data: value, fetchedAt };
+  } catch (error) {
+    return { status, error: error instanceof Error ? error.message : String(error), fetchedAt };
+  } finally {
+    inflight.delete(key);
+  }
+}
