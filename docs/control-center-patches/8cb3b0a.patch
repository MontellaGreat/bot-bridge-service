+  const bridgeEnvelopeError = (envelope: unknown): string | null => {
+    const root = (envelope && typeof envelope === "object") ? envelope as Record<string, unknown> : null;
+    const error = typeof root?.error === "string" ? root.error : null;
+    return error;
+  };
+
+  const bridgeEnvelopeData = (envelope: unknown): Record<string, unknown> | null => {
+    const root = (envelope && typeof envelope === "object") ? envelope as Record<string, unknown> : null;
+    const data = root?.data;
+    return data && typeof data === "object" ? data as Record<string, unknown> : null;
+  };
+
+  const renderBridgeErrorNotice = (title: string, envelope: unknown): string => {
+    const error = bridgeEnvelopeError(envelope);
+    if (!error) return "";
+    return `<section class="card"><h2>${escapeHtml(title)}</h2><div class="meta">${escapeHtml(t("Bridge data could not be loaded.", "Bridge 数据暂未接通。"))}</div><div class="callout danger" style="margin-top:12px;">${escapeHtml(error)}</div></section>`;
+  };
