BRIDGE_PORT=8787
BRIDGE_TOKEN=change-me
BRIDGE_WORKER_TOKEN=change-me-worker
BRIDGE_DATA_DIR=./data
BRIDGE_DB_FILE=./data/bridge.sqlite

